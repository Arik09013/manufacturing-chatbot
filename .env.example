# ── LLM synthesis backend ──────────────────────────────────────────────
# Which backend narrates the pipeline output. Supported values:
#   anthropic | claude   → hosted Claude
#   groq                 → hosted Llama (Groq)
#   ollama               → local Ollama, model from OLLAMA_MODEL below
#   ollama_llama         → local Ollama, llama3.2   (balanced baseline)
#   ollama_qwen          → local Ollama, qwen2.5:3b (technical reasoning, multilingual)
#   ollama_mistral       → local Ollama, mistral:7b (fast, CPU-efficient)
# Full registry + per-backend models live in config/llm.yaml (env vars win over it).
# (If 'anthropic' is selected but ANTHROPIC_API_KEY is missing while GROQ_API_KEY
#  is set, it auto-falls back to Groq so the demo still runs. Any backend failure
#  falls back to the deterministic grounded summary — it never crashes.)
SYNTHESIZER_BACKEND=anthropic

# ── Anthropic (Claude) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model used to NARRATE deterministic results (anomaly / param / welding knowledge).
# Cheap is fine here — it only phrases pre-computed output.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Model for GENERAL manufacturing questions (CNC, moulding, casting, additive,
# lean/OEE…). Here the model IS the knowledge source, so use a capable one.
ANTHROPIC_GENERAL_MODEL=claude-opus-4-8

# ── Groq (fast hosted Llama) ───────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local, offline) ────────────────────────────────────────────
# For a fully-local setup set SYNTHESIZER_BACKEND=ollama (or ollama_qwen /
# ollama_mistral / ollama_llama) above — no cloud key needed.
# Pull the models first, e.g.:  ollama pull qwen2.5:3b && ollama pull mistral:7b
OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL only applies to the generic 'ollama' backend; the ollama_qwen /
# ollama_mistral / ollama_llama backends are pinned to their model in config/llm.yaml
# so the benchmark can compare them side by side.
OLLAMA_MODEL=llama3.2
# Seconds to wait for a local generation (local models are slower than a hosted API).
OLLAMA_TIMEOUT=120
